# Copy this file to .env for local work and fill in the blanks. Nothing here is a real value.
# Django reads the process environment only. Nothing loads .env for you, so export the values in
# your shell or let scripts/dev.ps1 and scripts/dev.sh do it.

# --- Django ---------------------------------------------------------------------------------
# Required unless DJANGO_DEBUG=1. Use a long random string, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Leave unset in production. Set to 1 for local work (it also allows an insecure default key).
DJANGO_DEBUG=
# Comma-separated host names the app answers to. On Vercel, VERCEL_URL and
# VERCEL_PROJECT_PRODUCTION_URL are added for you, along with .vercel.app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, with scheme, that may send unsafe requests. Your custom domain goes here.
CSRF_TRUSTED_ORIGINS=
# Redirect plain HTTP to HTTPS. Defaults to on whenever DJANGO_DEBUG is off.
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------------------------
# Leave unset locally to use backend/db.sqlite3. Required on Vercel (the disk is read-only).
# Neon example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# --- Proxy ----------------------------------------------------------------------------------
# Trust X-Forwarded-For and X-Forwarded-Proto. Turn this on only behind a proxy you control.
# It defaults to on when running on Vercel and off everywhere else.
TRUST_PROXY_HEADERS=
# How many proxies append to X-Forwarded-For before a request reaches Django.
TRUSTED_PROXY_COUNT=1

# --- Map services ---------------------------------------------------------------------------
# The defaults are the public servers. Point these at your own instances for heavy use.
OSRM_BASE_URL=https://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's policy asks for a User-Agent that names the app and a way to reach you.
HTTP_USER_AGENT=ELDTripPlanner/1.0 (your-name; you@example.com)
# Hours a routing answer stays cached. 0 turns the cache off.
ROUTE_CACHE_TTL_HOURS=168
